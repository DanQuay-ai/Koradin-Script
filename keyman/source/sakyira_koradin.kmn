store(&VERSION) '17.0'
store(&NAME) 'Kɔradin (Sakyira)'
store(&COPYRIGHT) '© 2026 Ntirikwaamaa, Merankron'
store(&KEYBOARDVERSION) '0.7'
store(&LAYOUTFILE) 'sakyira_koradin.keyman-touch-layout'
store(&TARGETS) 'any'
store(&MNEMONICLAYOUT) '1'
c Follows the typist's own layout (AZERTY, QWERTY, QWERTZ...).
c Twi uses neither x nor c, so: x types ɛ, c types ɔ (also 3 → ɛ). Type the key twice to get the Latin letter back.
begin Unicode > use(main)
group(main) using keys
'ɛ' + 'x' > 'x'
'ɔ' + 'c' > 'c'
+ 'x' > 'ɛ'
+ 'X' > 'Ɛ'
+ 'c' > 'ɔ'
+ 'C' > 'Ɔ'
+ '3' > 'ɛ'

c ===TOUCH===
c Adaptive touch keyboard: one key per family, tap to open its signs.
+ [T_H_H] > 'h' layer('f_h')
+ [T_H_W] > 'w' layer('f_w')
